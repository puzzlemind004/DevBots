{
  "name": "devbots",
  "displayName": "DevBots",
  "description": "Flux de dev guidé dans VS Code : import des tickets, planification, agents Claude Code, review et merge.",
  "version": "0.4.0",
  "publisher": "alpidev",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.108.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.work"
  ],
  "contributes": {
    "configuration": {
      "title": "DevBots",
      "properties": {
        "devbots.source.kind": {
          "type": "string",
          "enum": [
            "github",
            "azureDevOps"
          ],
          "enumDescriptions": [
            "Issues GitHub (issue parente et sub-issues)",
            "Work items Azure DevOps (epic, feature, user story)"
          ],
          "default": "github",
          "markdownDescription": "Source des tickets pour ce dépôt.",
          "scope": "resource"
        },
        "devbots.github.repository": {
          "type": "string",
          "default": "",
          "markdownDescription": "Dépôt GitHub des issues, au format `owner/repo`. Vide : déduit du remote `origin`.",
          "scope": "resource"
        },
        "devbots.azureDevOps.orgUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "URL de l'organisation, par exemple `https://dev.azure.com/mon-org` (Services) ou `https://ado.interne/tfs/DefaultCollection` (Server).",
          "scope": "resource"
        },
        "devbots.azureDevOps.project": {
          "type": "string",
          "default": "",
          "markdownDescription": "Nom du projet Azure DevOps.",
          "scope": "resource"
        },
        "devbots.workDir": {
          "type": "string",
          "default": ".work",
          "markdownDescription": "Dossier du flux, relatif à la racine du dépôt.",
          "scope": "resource"
        },
        "devbots.import.downloadAssets": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Télécharger les images et pièces jointes des tickets dans un sous-dossier `assets` de la story.",
          "scope": "resource"
        },
        "devbots.import.githubTrustedAuthorsOnly": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "N'importer que les issues dont tu es l'auteur, ou qui portent un label de confiance. Protège des dépôts publics où n'importe qui ouvre une issue.",
          "scope": "resource"
        },
        "devbots.import.githubTrustedLabel": {
          "type": "string",
          "default": "devbots",
          "markdownDescription": "Label qui marque une issue comme validée pour l'import, en plus de tes propres issues.",
          "scope": "resource"
        },
        "devbots.sync.intervalMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440,
          "default": 0,
          "markdownDescription": "Resynchronisation avec la source en arrière-plan, en minutes (5 au minimum). `0` : désactivée, la resynchronisation se lance à la demande depuis le panneau. Elle ne fait que lire : rien n'est écrit chez la source.",
          "scope": "resource"
        },
        "devbots.planning.skill": {
          "type": "string",
          "default": "",
          "markdownDescription": "Skill de planification du dépôt, sans la barre oblique (par exemple `plan-story`). Il ouvre chaque atelier. Vide : consigne générique de DevBots.",
          "scope": "resource"
        },
        "devbots.planning.template": {
          "type": "string",
          "default": "",
          "markdownDescription": "Gabarit de plan de story, relatif à la racine du dépôt. Vide : `templates/plan.md` du dossier du flux s'il existe, sinon le gabarit par défaut. La commande « personnaliser les gabarits » dépose ce fichier. Marqueurs : `{{title}}`, `{{source_id}}`, `{{story}}`, `{{comprehension}}`, `{{couverture}}`, `{{etapes}}`, `{{tests}}`, `{{dependances}}`, `{{execution}}`, `{{plan}}`, `{{modele}}`, `{{complexite}}`.",
          "scope": "resource"
        },
        "devbots.planning.model": {
          "type": "string",
          "default": "opus",
          "markdownDescription": "Modèle de l'atelier de planification (`opus`, `sonnet`, ou un nom complet). Vide : modèle par défaut de Claude Code.",
          "scope": "resource"
        },
        "devbots.planning.maxResumes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "markdownDescription": "Nombre maximal de reprises d'une session de planification (réponses, commentaires). Au-delà, l'atelier demande de recommencer.",
          "scope": "resource"
        },
        "devbots.agents.maxParallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 2,
          "markdownDescription": "Nombre maximal d'agents en parallèle (dev, revue, supervision). Un build Angular consomme beaucoup de mémoire : à régler selon la machine, pas seulement selon le quota.",
          "scope": "window"
        },
        "devbots.dev.skill": {
          "type": "string",
          "default": "",
          "markdownDescription": "Skill de dev du dépôt, sans la barre oblique (par exemple `dev-story`). Il ouvre chaque session de dev. Vide : consigne générique de DevBots.",
          "scope": "resource"
        },
        "devbots.dev.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Modèle de l'agent de dev proposé au lancement. Vide : celui que recommande le plan (`opus`, `sonnet` ou `haiku`).",
          "scope": "resource"
        },
        "devbots.dev.allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "npx ng build",
            "npx ng test --watch=false",
            "npm run build",
            "npm test",
            "npm run test",
            "npm run lint",
            "git status",
            "git diff",
            "git log",
            "git show"
          ],
          "markdownDescription": "Commandes que l'agent de dev peut lancer, par préfixe : `npm run build` autorise aussi `npm run build -- --configuration=x`. Toute autre commande est refusée. `git push`, `git commit`, les changements de branche et `ng serve` restent refusés quoi qu'il arrive.",
          "scope": "resource"
        },
        "devbots.dev.installCommand": {
          "type": "string",
          "default": "",
          "markdownDescription": "Installation des dépendances d'un worktree neuf. Vide : déduite du fichier de verrouillage (`pnpm install --frozen-lockfile`, `npm ci`…). `none` : aucune.",
          "scope": "resource"
        },
        "devbots.dev.rulesFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Règles de dev à donner à l'agent, relatif au dépôt (par exemple `docs/regle-dev.md`). Vide : le `CLAUDE.md` du dépôt, chargé d'office, suffit.",
          "scope": "resource"
        },
        "devbots.dev.checkCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Commandes lancées par DevBots dans le worktree après chaque session de dev, dans l'ordre : par exemple `npx nx run-many -t build,test,lint -p mon-projet`. Le premier échec repart à l'agent avec la fin de sa sortie, sans revue. Renseignées, l'agent ne lance plus la suite complète lui-même, seulement les tests ciblés : aucun token dépensé à attendre un build. Vide : l'agent valide lui-même.",
          "scope": "resource"
        },
        "devbots.dev.correctionMaxTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500,
          "default": 40,
          "markdownDescription": "Plafond de tours d'une session de correction (`--max-turns`). Au-delà, la story est bloquée et te revient. 0 : aucun plafond.",
          "scope": "resource"
        },
        "devbots.agents.storyBudgetUsd": {
          "type": "number",
          "minimum": 0,
          "default": 10,
          "markdownDescription": "Budget d'une story, en dollars estimés par Claude Code, toutes sessions comprises (dev, revue, supervision, corrections). Sur abonnement, c'est la mesure de ce que la story prend sur ton quota. Atteint, la story est bloquée avant la session suivante ; la relancer lui rouvre un budget. 0 : aucun budget.",
          "scope": "resource"
        },
        "devbots.git.baseBranch": {
          "type": "string",
          "default": "",
          "markdownDescription": "Branche de départ des branches de feature (`feature/<id>-<slug>`), créées au lancement de la première story de la feature. Vide : la branche courante du dépôt.",
          "scope": "resource"
        },
        "devbots.worktrees.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "Dossier des worktrees des stories, relatif au dépôt ou absolu. Vide : `<dépôt>.worktrees`, à côté du dépôt.",
          "scope": "resource"
        },
        "devbots.supervision.model": {
          "type": "string",
          "default": "opus",
          "markdownDescription": "Modèle de la revue du CR et des étapes de supervision qui n'en fixent pas.",
          "scope": "resource"
        },
        "devbots.supervision.maxLoops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 2,
          "markdownDescription": "Nombre maximal de boucles de correction (revue du CR ou supervision) avant que la story te revienne. Chaque boucle ne revérifie que les points demandés, sur le diff de la correction. `maxLoops` de `.work/supervision.json` est prioritaire.",
          "scope": "resource"
        },
        "devbots.merge.checkCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Commandes relancées au merge, dans le worktree, quand la branche de la feature a avancé depuis la revue : par exemple `npx ng build` et `npx ng test --watch=false`. Une commande en échec renvoie la story à l'agent. Vide : aucune.",
          "scope": "resource"
        },
        "devbots.review.serveCommand": {
          "type": "string",
          "default": "npx ng serve --port {port}",
          "markdownDescription": "Lance l'application d'un worktree pour ta revue, dans un terminal. `{port}` reçoit un port propre au worktree. Vide : bouton désactivé.",
          "scope": "resource"
        },
        "devbots.review.basePort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65000,
          "default": 4201,
          "markdownDescription": "Premier port attribué aux worktrees en revue (4201, 4202…), pour ne jamais disputer le 4200 au dépôt principal.",
          "scope": "resource"
        },
        "devbots.claude.executable": {
          "type": "string",
          "default": "claude",
          "markdownDescription": "Commande du CLI Claude Code.",
          "scope": "window"
        },
        "devbots.notifications.level": {
          "type": "string",
          "enum": [
            "all",
            "actions",
            "none"
          ],
          "enumDescriptions": [
            "Tout : revue attendue, blocages, merges, retours à l'agent, changements dans la source",
            "Seulement ce qui attend un geste de ta part : revue, blocage, merge impossible ou incomplet, changement dans la source",
            "Aucune : le badge de l'icône DevBots et la barre d'état suffisent"
          ],
          "default": "all",
          "markdownDescription": "Notifications du flux. Le badge de l'icône DevBots compte toujours les stories qui t'attendent (à valider, bloquées, à revoir), quel que soit ce réglage.",
          "scope": "window"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devbots",
          "title": "DevBots",
          "icon": "resources/devbots.svg"
        }
      ]
    },
    "views": {
      "devbots": [
        {
          "id": "devbots.flow",
          "name": "Flux",
          "icon": "resources/devbots.svg"
        },
        {
          "id": "devbots.usage",
          "type": "webview",
          "name": "Usage Claude",
          "icon": "resources/devbots.svg",
          "size": 1
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "devbots.flow",
        "contents": "Aucune story pour l'instant.\n\nPremier passage dans ce dépôt ? [Installer le skill d'initialisation](command:devbots.installInitSkill), puis lance /devbots-init dans Claude Code.\n\n[Importer des tickets](command:devbots.importTickets)\n\n[Ajouter une story à la main](command:devbots.newStory)\n\nTu choisis dans la liste des issues GitHub ou des work items Azure DevOps ouverts. Les stories importées ou saisies arrivent dans `.work/new`."
      }
    ],
    "commands": [
      {
        "command": "devbots.importTickets",
        "title": "DevBots : importer des tickets",
        "icon": "$(cloud-download)"
      },
      {
        "command": "devbots.newStory",
        "title": "DevBots : nouvelle story",
        "icon": "$(add)"
      },
      {
        "command": "devbots.newFeature",
        "title": "DevBots : nouvelle feature",
        "icon": "$(layers)"
      },
      {
        "command": "devbots.deleteCard",
        "title": "DevBots : supprimer la fiche",
        "icon": "$(trash)"
      },
      {
        "command": "devbots.resync",
        "title": "DevBots : resynchroniser avec la source",
        "icon": "$(sync)"
      },
      {
        "command": "devbots.reviewSourceChange",
        "title": "DevBots : voir les changements de la source",
        "icon": "$(git-compare)"
      },
      {
        "command": "devbots.refresh",
        "title": "DevBots : rafraîchir le flux",
        "icon": "$(refresh)"
      },
      {
        "command": "devbots.openStory",
        "title": "DevBots : ouvrir la fiche"
      },
      {
        "command": "devbots.planStory",
        "title": "DevBots : planifier la story",
        "icon": "$(lightbulb-sparkle)"
      },
      {
        "command": "devbots.openInSource",
        "title": "DevBots : ouvrir dans la source",
        "icon": "$(link-external)"
      },
      {
        "command": "devbots.startDev",
        "title": "DevBots : lancer le dev",
        "icon": "$(play)"
      },
      {
        "command": "devbots.stopDev",
        "title": "DevBots : arrêter l'agent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "devbots.retryDev",
        "title": "DevBots : relancer la story",
        "icon": "$(debug-restart)"
      },
      {
        "command": "devbots.dequeue",
        "title": "DevBots : retirer du flux de dev"
      },
      {
        "command": "devbots.showJournal",
        "title": "DevBots : journal de l'agent",
        "icon": "$(output)"
      },
      {
        "command": "devbots.openReport",
        "title": "DevBots : rapport de supervision",
        "icon": "$(checklist)"
      },
      {
        "command": "devbots.openCr",
        "title": "DevBots : compte rendu de dev",
        "icon": "$(book)"
      },
      {
        "command": "devbots.openRunDocs",
        "title": "DevBots : comptes rendus (CR de l'agent, supervision)",
        "icon": "$(book)"
      },
      {
        "command": "devbots.approve",
        "title": "DevBots : feu vert (merge)",
        "icon": "$(check)"
      },
      {
        "command": "devbots.sendFeedback",
        "title": "DevBots : écrire à l'agent (retours, réponse à un blocage)",
        "icon": "$(mail)"
      },
      {
        "command": "devbots.showDiff",
        "title": "DevBots : voir le diff",
        "icon": "$(diff)"
      },
      {
        "command": "devbots.openWorktree",
        "title": "DevBots : ouvrir le worktree",
        "icon": "$(folder-opened)"
      },
      {
        "command": "devbots.openAgentSession",
        "title": "DevBots : discuter avec l'agent dans Claude Code",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "devbots.serveApp",
        "title": "DevBots : lancer l'application",
        "icon": "$(run)"
      },
      {
        "command": "devbots.decideDependency",
        "title": "DevBots : trancher une dépendance"
      },
      {
        "command": "devbots.reclassify",
        "title": "DevBots : reclasser la fiche (New ↔ Ready)",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "devbots.alreadyDone",
        "title": "DevBots : déjà fait (Done, ou vérification par un agent)",
        "icon": "$(pass)"
      },
      {
        "command": "devbots.openVerification",
        "title": "DevBots : rapport de vérification « déjà fait »",
        "icon": "$(checklist)"
      },
      {
        "command": "devbots.refreshUsage",
        "title": "DevBots : relever l'usage Claude",
        "icon": "$(refresh)"
      },
      {
        "command": "devbots.setToken",
        "title": "DevBots : enregistrer un jeton d'accès"
      },
      {
        "command": "devbots.clearToken",
        "title": "DevBots : effacer le jeton d'accès"
      },
      {
        "command": "devbots.checkClaude",
        "title": "DevBots : vérifier l'installation de Claude Code"
      },
      {
        "command": "devbots.customizeTemplates",
        "title": "DevBots : personnaliser les gabarits"
      },
      {
        "command": "devbots.customizeSupervision",
        "title": "DevBots : personnaliser la supervision"
      },
      {
        "command": "devbots.installInitSkill",
        "title": "DevBots : installer le skill d'initialisation"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devbots.importTickets",
          "when": "view == devbots.flow",
          "group": "navigation@1"
        },
        {
          "command": "devbots.newStory",
          "when": "view == devbots.flow",
          "group": "navigation@2"
        },
        {
          "command": "devbots.refresh",
          "when": "view == devbots.flow",
          "group": "navigation@3"
        },
        {
          "command": "devbots.resync",
          "when": "view == devbots.flow",
          "group": "1_create@2"
        },
        {
          "command": "devbots.refreshUsage",
          "when": "view == devbots.usage",
          "group": "navigation@1"
        },
        {
          "command": "devbots.newFeature",
          "when": "view == devbots.flow",
          "group": "1_create@1"
        }
      ],
      "view/item/context": [
        {
          "command": "devbots.reviewSourceChange",
          "when": "view == devbots.flow && viewItem =~ /:changed/",
          "group": "inline@0"
        },
        {
          "command": "devbots.planStory",
          "when": "view == devbots.flow && viewItem =~ /story:new/",
          "group": "inline@1"
        },
        {
          "command": "devbots.openInSource",
          "when": "view == devbots.flow && viewItem =~ /^(story|feature).*:linked/",
          "group": "inline@2"
        },
        {
          "command": "devbots.deleteCard",
          "when": "view == devbots.flow && viewItem =~ /^(story:(new|ready|done)|feature)/",
          "group": "9_delete@1"
        },
        {
          "command": "devbots.newStory",
          "when": "view == devbots.flow && viewItem =~ /^feature/",
          "group": "inline@1"
        },
        {
          "command": "devbots.newStory",
          "when": "view == devbots.flow && viewItem == group:new",
          "group": "inline@1"
        },
        {
          "command": "devbots.newFeature",
          "when": "view == devbots.flow && viewItem == group:new",
          "group": "inline@2"
        },
        {
          "command": "devbots.startDev",
          "when": "view == devbots.flow && viewItem =~ /^story:ready/",
          "group": "inline@1"
        },
        {
          "command": "devbots.stopDev",
          "when": "view == devbots.flow && viewItem =~ /^story:dev:(in_dev|ai_review|pre_pr_check)/",
          "group": "inline@1"
        },
        {
          "command": "devbots.retryDev",
          "when": "view == devbots.flow && viewItem =~ /^story:dev:blocked/",
          "group": "inline@1"
        },
        {
          "command": "devbots.showJournal",
          "when": "view == devbots.flow && viewItem =~ /^story:dev/",
          "group": "inline@3"
        },
        {
          "command": "devbots.openRunDocs",
          "when": "view == devbots.flow && viewItem =~ /^story:dev:blocked.*:(cr|report)(:|$)/",
          "group": "inline@2"
        },
        {
          "command": "devbots.openAgentSession",
          "when": "view == devbots.flow && viewItem =~ /^story:dev:blocked/",
          "group": "inline@1"
        },
        {
          "command": "devbots.approve",
          "when": "view == devbots.flow && viewItem =~ /^story:review:awaiting_human/",
          "group": "inline@1"
        },
        {
          "command": "devbots.openAgentSession",
          "when": "view == devbots.flow && viewItem =~ /^story:review:awaiting_human/",
          "group": "inline@2"
        },
        {
          "command": "devbots.showDiff",
          "when": "view == devbots.flow && viewItem =~ /^story:(review|done:done)/",
          "group": "inline@3"
        },
        {
          "command": "devbots.openWorktree",
          "when": "view == devbots.flow && viewItem =~ /^story:review:awaiting_human/",
          "group": "inline@4"
        },
        {
          "command": "devbots.showDiff",
          "when": "view == devbots.flow && viewItem =~ /^story:dev:blocked/",
          "group": "7_review@1"
        },
        {
          "command": "devbots.openWorktree",
          "when": "view == devbots.flow && viewItem =~ /^story:dev:(in_dev|ai_review|pre_pr_check|blocked)/",
          "group": "inline@4"
        },
        {
          "command": "devbots.openWorktree",
          "when": "view == devbots.flow && viewItem =~ /^story:(dev|review)/",
          "group": "7_review@2"
        },
        {
          "command": "devbots.sendFeedback",
          "when": "view == devbots.flow && viewItem =~ /^story:(dev:blocked|review:awaiting_human)/",
          "group": "7_review@0"
        },
        {
          "command": "devbots.serveApp",
          "when": "view == devbots.flow && viewItem =~ /^story:review:awaiting_human/",
          "group": "7_review@3"
        },
        {
          "command": "devbots.openCr",
          "when": "view == devbots.flow && viewItem =~ /^story:(review|done:done)/",
          "group": "7_review@4"
        },
        {
          "command": "devbots.openReport",
          "when": "view == devbots.flow && viewItem =~ /^story:(review|done:done)/",
          "group": "7_review@5"
        },
        {
          "command": "devbots.showJournal",
          "when": "view == devbots.flow && viewItem =~ /^story:(review|done:done)/",
          "group": "7_review@6"
        },
        {
          "command": "devbots.dequeue",
          "when": "view == devbots.flow && viewItem =~ /^story:(dev:(queued|blocked)|review:awaiting_human)/",
          "group": "8_flow@1"
        },
        {
          "command": "devbots.decideDependency",
          "when": "view == devbots.flow && viewItem =~ /^story:(ready|dev:queued)/",
          "group": "8_flow@2"
        },
        {
          "command": "devbots.reclassify",
          "when": "view == devbots.flow && viewItem =~ /^story:(new|ready).*:followup/",
          "group": "8_flow@3"
        },
        {
          "command": "devbots.alreadyDone",
          "when": "view == devbots.flow && viewItem =~ /^story:(new|ready)(?!.*:verifying)/",
          "group": "8_flow@4"
        },
        {
          "command": "devbots.openVerification",
          "when": "view == devbots.flow && viewItem =~ /^story:done.*:outside-verified/",
          "group": "7_review@1"
        }
      ],
      "commandPalette": [
        {
          "command": "devbots.openStory",
          "when": "false"
        },
        {
          "command": "devbots.openInSource",
          "when": "false"
        },
        {
          "command": "devbots.deleteCard",
          "when": "false"
        },
        {
          "command": "devbots.reclassify",
          "when": "false"
        },
        {
          "command": "devbots.openVerification",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check && npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "package": "vsce package --no-dependencies --skip-license --allow-missing-repository --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/turndown": "^5.0.5",
    "@types/vscode": "^1.108.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "azure-devops-node-api": "^17.0.1",
    "gray-matter": "^4.0.3",
    "octokit": "^5.0.5",
    "turndown": "^7.2.4"
  }
}
